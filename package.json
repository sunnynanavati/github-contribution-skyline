{
  "name": "github-contribution-skyline",
  "version": "0.1.0",
  "description": "An accessible, themeable GitHub contribution skyline for React and the web.",
  "type": "module",
  "license": "MIT",
  "author": "Sunny Nanavati",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunnynanavati/github-contribution-skyline.git"
  },
  "homepage": "https://github.com/sunnynanavati/github-contribution-skyline#readme",
  "bugs": {
    "url": "https://github.com/sunnynanavati/github-contribution-skyline/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "github",
    "contributions",
    "skyline",
    "canvas",
    "react",
    "web-component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element/index.d.ts",
      "import": "./dist/element.js"
    }
  },
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build:lib": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "build": "npm run clean && vite build --config vite.library.config.ts && tsc -p tsconfig.build.json && vite build --config vite.demo.config.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('demo-dist',{recursive:true,force:true})\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "preview": "vite preview --config vite.demo.config.ts",
    "prepack": "npm run build",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^27.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
